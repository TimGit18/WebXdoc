<?xml version="1.0" encoding="UTF-8"?><fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="page" page-height="29.7cm" page-width="21cm" margin-top="1cm" margin-bottom="1cm" margin-left="2.5cm" margin-right="2.5cm">
            <fo:region-body margin-top="3cm" margin-bottom="1cm"/>
            <fo:region-before extent="2.5cm"/>
            <fo:region-after extent="0.5cm"/>
            <fo:region-start extent="2.5cm"/>
            <fo:region-end extent="0.5cm"/>
        </fo:simple-page-master>
        <fo:page-sequence-master master-name="single-page">
            <fo:repeatable-page-master-reference master-reference="page"/>
        </fo:page-sequence-master>
    </fo:layout-master-set>
    <fo:page-sequence master-reference="single-page" initial-page-number="1">
        <fo:static-content flow-name="xsl-region-before">
            <fo:block space-after="4pt" space-before="4pt" text-align="right">
                <fo:external-graphic src="url('file:///C:/Users/schmi/Daten/Web/xdoc/Ressources/logo.svg')" text-align="right"/>
            </fo:block>
        </fo:static-content>
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">
          &#133;Komponenten</fo:block>
            <fo:block text-align="start" font-family="Helvetica, Arial, sans-serif" font-size="10pt">Tim Schmitz</fo:block>
            <fo:block text-align="start" font-family="Helvetica, Arial, sans-serif" font-size="10pt">05.07.2023</fo:block>
        </fo:flow>
    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="2">
        <fo:static-content flow-name="xsl-region-before">
            <fo:block space-after="4pt" space-before="4pt" text-align="right">
                <fo:external-graphic src="url('file:///C:/Users/schmi/Daten/Web/xdoc/Ressources/logo.svg')" text-align="right"/>
            </fo:block>
        </fo:static-content>
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block space-after="10pt" space-before="10pt" text-align="start">
                          &#133;
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">
      Inhalt
    </fo:block>
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Definition
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Definition"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Hauptkomponente
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Hauptkomponente"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Decorator
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Decorator"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Template
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Template"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Styles
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Styles"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Deklaration
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Deklaration"/>
                        </fo:inline>
                    </fo:block>
                </fo:block>
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="3">
        <fo:static-content flow-name="xsl-region-before">
            <fo:block space-after="4pt" space-before="4pt" text-align="right">
                <fo:external-graphic src="url('file:///C:/Users/schmi/Daten/Web/xdoc/Ressources/logo.svg')" text-align="right"/>
                          &#133;&#133;
        
            </fo:block>
        </fo:static-content>
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block break-after="page" font-family="Helvetica, Arial, sans-serif">
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">Komponenten</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Komponenten definieren Ansichten (Views) für die Anwendung. Komponenten definieren also, was der Benutzer von der 
      Anwendung sieht. Technisch gesehen werden mit Komponenten neue HTML-Tags definiert. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="20pt" text-align="start" id="Definition">Definition</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Eine Komponente besteht aus drei Teilen:
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">1.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Eine Klasse mit dem Component-Decorator. Dieser definiert die Klasse zu einer Komponente.</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">2.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Ein Template, das im Grunde das HTML der Komponente enthält.</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">3.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Die Styles der Komponente, die über CSS-Stylesheets erzeugt werden können.	</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die Klasse und das Template sind erforderlich, die Styles dagegen sind optional. Es gibt zwei Möglichkeiten, das 
      Template und die Styles zu definieren. 
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Sie können direkt im Decorator als inline-Deklarationen angegeben werden</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Sie können auch in eigenen Dateien definiert werden und dann im Decorator referenziert werden</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      In dem letzteren Fall sollten die Komponenten dieselben Dateiendungen wie die Dateien mit den entsprechenden Klassen besitzen:
    </fo:block>
                    
                <fo:block space-after="10pt" space-before="10pt">
                    <fo:table table-layout="fixed" width="100%">
                        <fo:table-header>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block background-color="#f0f0f0" font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">Kompomente</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block background-color="#f0f0f0" font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">Namen</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                        </fo:table-header>
                        <fo:table-body>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Klasse</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">app.component.ts</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Template</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">app.component.html</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Style</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">app.component.css</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                        </fo:table-body>
                    </fo:table>
                    <fo:block space-after="6pt" space-before="6pt" font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-style="italic">Tabelle 1: Bezeichner für Komponenten</fo:block>
                </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="20pt" text-align="start" id="Hauptkomponente">Hauptkomponente</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die Hauptkomponente wurde von der Angular-Enwicklungsumgebung erzeugt und besitzt folgendes Aussehen:
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        import { Component } from '@angular/core';
      
        @Component({
          selector: 'app-root',
          templateUrl: './app.component.html',
          styleUrls: ['./app.component.css']
        })
        export class AppComponent {
          title = 'The Contacts-Manager';
        }
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Diese Klasse definiert Eigenschaften und Methoden. Diese können im Template referenziert werden und zum Beispiel
      dem Benutzer den Wert einer Eigenschaft anzeigen. Standardmäßig wird in der Hauptkomponente nur die Eigenschaft 
      "title" angezeigt. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="20pt" text-align="start" id="Decorator">Decorator</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Der Component-Decorator wird mit dem Schlüsselwort @Component deklariert und besitzt die folgenden Eigenschaften:
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">selector</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Diese Eigenschaft definiert den Tag-Namen (app-root), mit dem die Komponente im Template (app.component.html) 
      referenziert wird. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">templateUrl</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Diese Eigenschaft definiert das Template der Komponente. Normalerweise steht hier ein relativer Pfad zu einer 
      HTML-Datei. Wird hingegen nur die Eigenschaft "template" angegeben, so folgt ein vollqualifizierter HTML-Pfad.
      Diese Eigenschaft ist die einzige, die nicht optional ist. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">styleUrls </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Diese Eigenschaft definiert den Style der Komponente. Hier steht ein Array von Strings, jeder String ist ein 
      relativer Pfad zu einer CSS-Datei. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">providers</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Dieser Array registriert Providers für die Komponente und alle ihre Kinder.
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">viewEnscapsulation</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Diese Eigenschaft kapselt die Auswirkung von CSS-Styles auf bestimmte Bereiche. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="20pt" text-align="start" id="Template">Template</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Das Template der Komponente ist eine HTML-Datei. Sie definiert, was der Nutzer zur Laufzeit sieht und wie der 
      Nutzer mit dieser interagiert. Das Template schreibt man mit HTML und weiteren Syntaxelementen, die in Angular 
      zur Verfügung stehen. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Zum Beispiel gibt es im normalen HTML keine Möglichkeit aus einem Template eine Eigenscahft aus TypeScript zu 
      referenzieren. In Angular geschieht dies über das "Data Binding" (Datenbindung). Damit werden Eigenschaften und 
      Methoden im Template nutzbar.
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Ein Ausschnitt des Templates lautet zum Beispiel:
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        &lt;div class="card highlight-card card-small"&gt;
          &lt;span&gt;{{ title }} app is running now!&lt;/span&gt;
          ...	
        &lt;/div&gt;
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die Datenbindung lautet damit {{title}}. Damit sieht der Benutzer zur Laufzeit den Wert der Eigenschaft title aus 
      der Komponente. Diese Eigenschaft und deren Wert sind in der Klasse der Komponente definiert.
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        export class AppComponent {
          title = 'The Contacts-Manager';
        }
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Falls sich der Wert von title zur Laufzeit ändert, dann wird auch die Ansicht entsprechend angepasst. Abgesehen davon 
      besteht der Rest des Templates aus regulärem HTML. Diese Art der Datenbindung heißt Interpolation, die sich am besten 
      für Strings und Zahlen als Werte eignet. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Der Prozess, der auf die Datenbindung reagiert, heißt in Angular Change Detection. Er überprüft, ob sich Daten geändert 
      haben. Der Prozess selbst wird vom Webserver durchgeführt, sobald ein Ereignis eintritt.
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="20pt" text-align="start" id="Styles">Styles</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Jede Komponente kann ihre eigenen Styles besitzen.  Diese stehen in einer (leer generierten) Datei app.component.css. 
      Die globalen Styles stehen in der Hauptdatei styles.css. Es macht Sinn die Styles zu lokalisieren, um die globale Datei 
      zu entlasten und die Auswirkungen zu limitieren. Referenziert werden die Styles in dem Stylesheet-Pfad des Decorators
      unter der Eigenschaft styleUrls. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Es gibt folgende Vorteile, Styles für eine Komponente zu definieren:
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Es gibt weniger globale Styles und somit auch eine kleinere globale Datei styles.css</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Komponenten-lokale Styles habe keine Auswirkungen auf andere Komponenten</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Diese Einschränkungen können durch ViewEncapsulation geändert werden. 
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">None: Die Styles werden global angewendet, man kann aber externe Bibliotheken wie Bootstrap einbinden</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Emulated: Das ist die Standardeinstellung, in der die Styles nur lokal angewendet werden, globale Styles allerdings auch</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">ShadowDom: Die Styles wirken sich nur auf die definierende Komponente aus</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="20pt" text-align="start" id="Deklaration">Deklaration</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Jede Komponente muss deklariert werden, d.h. die Klasse der Komponente muss im declarations-Array des Angular-Modul stehen. Ansonsten
      würde es zur Laufzeit zu einer Exception kommen. Das Code-Listing des Modules sieht wie folgt aus:
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        import { AppComponent } from './app.component';
        
        @NgModule({
          declarations: [
            AppComponent
          ],
          ...
        })
        export class AppModule { }
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Damit gehört die Komponente zum Module. Die Komponente darf nur in genau einem Angular-Modul deklariert werden. 
    </fo:block>
                  
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
