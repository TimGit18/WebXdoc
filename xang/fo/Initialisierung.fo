                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Projekt-Initialisierung
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Projekt-Initialisierung"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Verzeichnisstruktur
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Verzeichnisstruktur"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            angular.json
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="angular.json"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            ng build
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="ng build"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            ng serve
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="ng serve"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            ng lint
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="ng lint"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Checkliste
