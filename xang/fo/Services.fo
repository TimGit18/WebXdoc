<?xml version="1.0" encoding="UTF-8"?><fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="page" page-height="29.7cm" page-width="21cm" margin-top="1cm" margin-bottom="1cm" margin-left="2.5cm" margin-right="2.5cm">
            <fo:region-body margin-top="3cm" margin-bottom="1cm"/>
            <fo:region-before extent="2.5cm"/>
            <fo:region-after extent="0.5cm"/>
            <fo:region-start extent="2.5cm"/>
            <fo:region-end extent="0.5cm"/>
        </fo:simple-page-master>
        <fo:page-sequence-master master-name="single-page">
            <fo:repeatable-page-master-reference master-reference="page"/>
        </fo:page-sequence-master>
    </fo:layout-master-set>
    <fo:page-sequence master-reference="single-page" initial-page-number="1">
        <fo:static-content flow-name="xsl-region-before">
            <fo:block space-after="4pt" space-before="4pt" text-align="right">
                <fo:external-graphic src="url('file:///C:/Users/schmi/Daten/Web/xdoc/Ressources/logo.svg')" text-align="right"/>
            </fo:block>
        </fo:static-content>
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">
          &#133;Services</fo:block>
            <fo:block text-align="start" font-family="Helvetica, Arial, sans-serif" font-size="10pt">Tim Schmitz</fo:block>
            <fo:block text-align="start" font-family="Helvetica, Arial, sans-serif" font-size="10pt">05.07.2023</fo:block>
        </fo:flow>
    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="2">
        <fo:static-content flow-name="xsl-region-before">
            <fo:block space-after="4pt" space-before="4pt" text-align="right">
                <fo:external-graphic src="url('file:///C:/Users/schmi/Daten/Web/xdoc/Ressources/logo.svg')" text-align="right"/>
            </fo:block>
        </fo:static-content>
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block space-after="10pt" space-before="10pt" text-align="start">
                          &#133;
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">
      Inhalt
    </fo:block>
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Definition
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Definition"/>
                        </fo:inline>
                    </fo:block>
                    <fo:block text-align-last="justify">
                        <fo:inline>
                            Registrierung
                            <fo:leader leader-pattern="dots"/>
                            <fo:page-number-citation ref-id="Registrierung"/>
                        </fo:inline>
                    </fo:block>
                </fo:block>
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="3">
        <fo:static-content flow-name="xsl-region-before">
            <fo:block space-after="4pt" space-before="4pt" text-align="right">
                <fo:external-graphic src="url('file:///C:/Users/schmi/Daten/Web/xdoc/Ressources/logo.svg')" text-align="right"/>
                          &#133;&#133;
        
            </fo:block>
        </fo:static-content>
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block break-after="page" font-family="Helvetica, Arial, sans-serif">
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">Services</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Wie jeder andere Baustein auch ist ein Service eine Klasse in TypeScript. Ein Service definiert die Logik eines 
      Anwendungsteils und enthält auch noch Hilfsmethoden. Diese Klasse wird aber erst dann zu einem Service, wenn sie 
      von einem Provider verwendet wird. Alle Bausteine, die von diesem Service abhängen, erhalten diesen dann auch 
      mittels Dependency Injection. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="20pt" text-align="start" id="Definition">Definition</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Das folgende Beispiel ist ein schlichter Service, der als einzige Funktion einen Array von Zahlen zurückgibt:
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        import { Injectable } from '@angular/core';
      
        @Injectable()
          export class DemoService {
            getData() {
              return [1, 2, 3];
          }
        }
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Diese Klasse wird mit dem Injectable-Decorator dekoriert. Somit erhält auch diese Klasse wie auch die Klassen von 
      Komponenten und Angular-Modulen Metadaten. Der Service kann ohne weiteres nicht genutzt werden. Sondern er muss als
      erstes registriert werden. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Wenn man eine neue Klasse (hier die Klasse DemoService als datei demo.service.ts im Verzeichnis demo) einem Projekt 
      hinzufügt, dann folgt manchmal die Warnung (im Visual Studio Code): "To enable code execution from the current workspace 
      you must enable workspace library execution". Dies erfolgt wie folgt:
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">1.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Aufrufen der Kommandopalette mit Ctrl + Shift + P</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">2.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Eingeben von "TSLint: Manage workspace library execution"</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">3.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Aufnehmen des entsprechenden Eintrags aus der Vorschlagsliste und die Return-Taste bedienen</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="20pt" text-align="start" id="Registrierung">Registrierung</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Bevor die Klasse DemoService zu einem Service wird und als solcher genutzt werden kann, muss er zunächst als Provider 
      registriert werden. Um dies zu erreichen, gibt es zwei Möglichkeiten:
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">1.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Die Service-Klasse kann von dem Angular-Module in einem providers-Array registriert werden</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">2.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Die Service-Klasse kann sich über den Injectable-Decorator selbst registrieren</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      In der ersten Variante das Angular-Module AppModule den providers-Array nutzen, um die Service-Klasse zu registrieren:
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        import { DemoService } from './../demo/demo.service';
        import { BrowserModule } from '@angular/platform-browser';
        import { NgModule } from '@angular/core';
        import { AppComponent } from './app.component';
      
        @NgModule({
          declarations: [ AppComponent],
          imports: [ BrowserModule],
          providers: [ DemoService ],
          bootstrap: [AppComponent]
        })
        export class AppModule { }
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Da der DemoService im Verzeichnis demo neben dem Hauptvereichnis app liegt, muss die Import-Direktive den relativen Pfad 
      qualifizieren. Die zweite Variante nutzt für die Selbstregistrierung wieder den Injectable-Decorator der Klasse DemoService.
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        import { Injectable } from '@angular/core';
      
        @Injectable({
          providedIn: 'root'
        })
        export class DemoService {
          getData() {
            return [1, 2, 3];
          }
        }
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Es wird ein Objekt mit der Eigenschaft "providedIn" übergeben. Der Wert dieser Eigenschaft gibt den Injektor an, in dem der 
      Service als Provider übergeben werden soll. Die Wertausprägung "root" legt nun fest, dass der Service im globalen Injektor 
      registriert werden soll. Der globale Injektor ist dabei identisch mit dem Angular-Hauptmodule AppModule. Man könnte auch ein
      Angular-Modul oder eine Komponente als Injektor angeben. Diese Providers heißen tree-shakeable Providers und sind bevorzugt im 
      Vergleich zu der Registrierung über providers-Arrays zu verwenden, da sie nur im JavaScript Code-Bundle verbleiben, wenn sie 
      auch benutzt werden. 
    </fo:block>
                  
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
