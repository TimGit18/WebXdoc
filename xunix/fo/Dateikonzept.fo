            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">
          &#133;Dateikonzept</fo:block>
            <fo:block text-align="start" font-family="Helvetica, Arial, sans-serif" font-size="10pt">Tim Schmitz</fo:block>
            <fo:block text-align="start" font-family="Helvetica, Arial, sans-serif" font-size="10pt">04.02.2024</fo:block>
        </fo:flow>
    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="2">
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">
      Inhalt
    </fo:block>
            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Verzeichnisstruktur
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Verzeichnisstruktur"/>
                    </fo:inline>
                </fo:block>
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="3">
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block break-after="page" font-family="Helvetica, Arial, sans-serif">
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">Dateikonzept</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Unix ist ein dateibasiertes Betriebssystem. Eine Datei (file) ist die kleinste sequentiell organisierte Einheit zusammenhängender Daten. Es gibt normale 
      Dateien, Dateikataloge (Verzeichnisse) und Gerätedateien. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Verzeichnisstruktur">Verzeichnisstruktur</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Unix besitzt eine hierarchische Dateistruktur. Die Struktur der Dateien und Kataloge ist ein invertierter Baum beliebiger Breite und Tiefe. Jede Datei 
      befindet sich in einem Verzeichnis (directory). Verzeichnisse beinhalten Dateien und Unterverzeichnisse. Die Hierarchie des Dateisystems beginnt mit der 
      Wurzel (root) und verteilt sich auf die verschiedenen Zweige.
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
          /               Root-Verzeichnis
              /bin        Ausführbare Programme
              /etc        Konfigurationsdateien
              /home       Nutzerverzeichnis
              /lib        Gemeinsam genutzte Bibliotheken
              /tmp        Temporäre Dateien
              /usr        Anwendungen
              /usr/local  Rechnerspezifische Anwendungen  
    </fo:block>
                    
                <fo:block space-after="4pt" space-before="4pt">
                    <fo:external-graphic src="url('file:///C:/Users/Test/Daten/Web/xdoc/xunix/img/Struktur.svg')"/>
                </fo:block>
                <fo:block space-after="6pt" space-before="6pt" font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-style="italic">
        Abbildung 1: Die Verzeichnisstruktur von Unix
      </fo:block>
                  
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
