          <tableheaditem>Bedeutung</tableheaditem>
        </tablerow>
      </tableheadline>
      <tablebody>
        <tablerow>
          <tableitem>id</tableitem>
          <tableitem>int</tableitem>
          <tableitem>Technischer Schlüssel</tableitem>
        </tablerow>
        <tablerow>
          <tableitem>id_magazine</tableitem>
          <tableitem>int</tableitem>
          <tableitem>Fremdschlüssel</tableitem>
        </tablerow>
        <tablerow>
          <tableitem>id_eco</tableitem>
          <tableitem>int</tableitem>
          <tableitem>Fremdschlüssel</tableitem>
        </tablerow>
        <tablerow>
          <tableitem>cbm_eco_description</tableitem>
          <tableitem>nvarchar(255)</tableitem>
          <tableitem>Artikelkurzbeschreibung</tableitem>
        </tablerow>
        <tablecaption>Tabelle 3: Felder der Tabelle Magazine_ECO</tablecaption>
      </tablebody>
    </table>

    <subheadline id="Query über alle drei Tabellen">Query über alle drei Tabellen</subheadline>

    <text>
      Die folgende Query stellt einen Join über alle drei verknüpften Tabellen dar:
    </text>
    <codebox>
        select t1.issue,
               t2.ecokey,
               t2.moves,
               t2.eco_description,
               t3.cbm_eco_description
        from   CBM.dbo.Magazine t1,
               CBM.dbo.ECO t2,
               CBM.dbo.Magazine_ECO t3
        where  t1.id = t3.id_magazine
        and    t2.id = t3.id_eco
        order by t2.ecokey;
    </codebox>


    <text>
      Dieser Abfrage selektiert alle Eröffnungsartikel mitsamt den dazugehörigen Eröffnungsschlüsseln und Magazinen sowie den 
      dazugehörigen Beschreibungen und Zügen. Sortiert wird der Result Set am Ende nach den Eröffnungsschlüsseln wie in der 
      folgenden Teilmenge dessen zeigt:
