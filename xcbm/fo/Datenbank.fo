                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Tabelle Magazine
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Tabelle Magazine"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
