                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Fachliche Datentypen
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Fachliche Datentypen"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Entität Magazin
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Entität Magazin"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Entität Eröffnungsschlüssel
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Entität Eröffnungsschlüssel"/>
