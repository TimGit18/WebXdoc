<?xml version="1.0" encoding="UTF-8"?><fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format">
    <fo:layout-master-set>
        <fo:simple-page-master master-name="page" page-height="29.7cm" page-width="21cm" margin-top="1cm" margin-bottom="1cm" margin-left="2.5cm" margin-right="2.5cm">
            <fo:region-body margin-top="1cm"/>
            <fo:region-before extent="3cm"/>
            <fo:region-after extent="0.5cm"/>
            <fo:region-start extent="2cm"/>
            <fo:region-end extent="0.5cm"/>
        </fo:simple-page-master>
        <fo:page-sequence-master master-name="single-page">
            <fo:repeatable-page-master-reference master-reference="page"/>
        </fo:page-sequence-master>
    </fo:layout-master-set>
    <fo:page-sequence master-reference="single-page" initial-page-number="1">
        <fo:static-content flow-name="xsl-region-before">
            <fo:block space-after="4pt" space-before="4pt" text-align="right">
                <fo:external-graphic src="url('file:///C:/Users/test/Daten/Web/xdoc/resources/logo.svg')" text-align="right"/>
            </fo:block>
        </fo:static-content>
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">
          &#133;Übersicht</fo:block>
            <fo:block text-align="start" font-family="Helvetica, Arial, sans-serif" font-size="10pt">Tim Schmitz</fo:block>
            <fo:block text-align="start" font-family="Helvetica, Arial, sans-serif" font-size="10pt">25.10.2024</fo:block>
        </fo:flow>
    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="2">
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">
      Inhalt
    </fo:block>
            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Fachlicher Hintergrund
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Fachlicher Hintergrund"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Architektur
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Architektur"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Verarbeitung
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Verarbeitung"/>
                    </fo:inline>
                </fo:block>
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="3">
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt" line-height="14pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block break-after="page" font-family="Helvetica, Arial, sans-serif">
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">Übersicht</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Diese Seite beschreibt eine Übersicht der CBM-Anwendung. Es wird die Architektur und Komponentensicht der Anwendung
      dargestellt ohne auf die Details der Verabeitung zu sehr einzugehen. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Fachlicher Hintergrund">Fachlicher Hintergrund</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Das Chessbase-Magazin (CBM) erscheint mehrmals jährlich und beinhaltet unter anderem digitale fachliche Artikel zu Schacheröffnungen. Diese Artikel 
      werden über einen Eröffnungsschlüssel namens ECO-Key identifiziert. Hierbei steht ECO für Encyclopedia of Chess Openings. Dies ist ein Index, der 
      von dem Belgrader Verlag Chess Informant entwickelt wurde, um Eröffnungen zu klassifizieren und zu strukturieren. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die Anwendung soll aus allen verfügbaren Ausgaben diese Eröffnungsartikel extrahieren und sie in der Anwendungsdatenbank in einer geordneten Struktur persistieren. 
      Hieraus soll ein Bericht im CSV-Format generiert werden, der alle erforderlichen Informationen enthält. Der Anwendungskontext besteht daher aus den folgenden Bereichen:
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">1.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Das Dateisystem, das sind Laufwerke und Verzeichnisse</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">2.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Der Anwendungskern, das sind Skripte mit eigenständigen Aufgaben</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">3.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Die Datenbank als Persistenzbereich für die verarbeiteten Daten</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Architektur">Architektur</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Dieser Abschnitt beschreibt die Architektur der Anwendung. Die Anwendung besteht aus einem Kern und Umsystemen. 
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Der Kern besteht aus drei Skripten, die in einer Python-Laufzeitumgebung prozessieren</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Die Umsysteme sind das Dateisystem und die anwendungsspezifische Datenbank</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die folgende Abbildung beschreibt das Zusammenspiel der Komponenten und skizziert im wesentlichen den Ablauf der 
      Verarbeitung vom Start links oben bis zum Ende rechts unten. 
    </fo:block>
                    
                <fo:block space-after="4pt" space-before="4pt" line-height="0pt">
                    <fo:external-graphic src="url('file:///C:/Users/Test/Daten/Web/xdoc/xcbm/img/Architektur.svg')"/>
                </fo:block>
                <fo:block space-after="6pt" space-before="6pt" font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-style="italic">
        Abbildung 1: Architektur der Anwendung
      </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Verarbeitung">Verarbeitung</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die Verarbeitung enthält folgende Schritte: 
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">1.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Der Parser liest Informationen aus den CBM-Magazinen, verbindet diese mit der Konfiguration der Eröffnungsschlüssel und schreibt diese Informationen in Dateien auf dem Dateisystem</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">2.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Der Importeur überträgt diese Informationen aus dem Dateisystem in die Datenbank, indem er zuerst die Tabellen initialisiert und danach diese befüllt</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">3.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Der Exporteur baut den Ziel-Bericht auf und befüllt diesen mit Daten aus der Datenbank</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                  
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
