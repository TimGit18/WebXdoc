    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        String meldung = "hello";
        System.out.println(meldung);
        subroutine(value);
        #?$
    </fo:block>
                    
