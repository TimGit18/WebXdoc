                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">~\Daten\Java\Projects</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                                  
                            <fo:table-row>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
