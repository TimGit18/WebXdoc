                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Dabei passiert folgendes:
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">1.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Das Projekt wird mit seinem Namen an einem physischem Ort initialisiert</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">2.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Es wird ein Git-Repository bei der Anlage erzeugt</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">3.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Die Build-Umgebung für das Projekt (Entwicklungsumgebung und JDK 21) wird festgelegt</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">4.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Vordefinierte Klassen (Sample Code) werden nicht erzeugt</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Hauptklasse">Hauptklasse</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Um Klassen zu erzeugen, muss zunächst eine Verzeichnisstruktur definiert werden.
      Die Startklasse der Anwendung wird dann in einem neuen Paket erzeugt. Zunächst wird im Projekt-Explorer 
      das Quellcode-Verzeichnis selektiert:
    </fo:block>
                    
                <fo:block space-after="6pt" space-before="6pt">
                    <fo:table table-layout="fixed" width="100%">
                        <fo:table-column column-width="30mm"/>
                        <fo:table-column column-width="10mm"/>
                        <fo:table-column column-width="60mm"/>
                        <fo:table-column column-width="60mm"/>
                        <fo:table-body>
                                  
                            <fo:table-row>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">src</fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">
          ==&gt;
        </fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Kontextmenü</fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                            </fo:table-row>
                                  
                            <fo:table-row>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">
          ==&gt;
        </fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">New</fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                            </fo:table-row>
                                  
                            <fo:table-row>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">
          ==&gt;
        </fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Package</fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                            </fo:table-row>
                                  
                            <fo:table-row>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Name</fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">de.domain.application.core</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                                
                        </fo:table-body>
                    </fo:table>
                </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Anschließend wird das Paket selektiert und die Hauptklasse angelegt:
    </fo:block>
                    
                <fo:block space-after="6pt" space-before="6pt">
                    <fo:table table-layout="fixed" width="100%">
                        <fo:table-column column-width="30mm"/>
                        <fo:table-column column-width="10mm"/>
                        <fo:table-column column-width="60mm"/>
                        <fo:table-column column-width="60mm"/>
                        <fo:table-body>
                                  
                            <fo:table-row>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Package</fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">
          ==&gt;
        </fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">New</fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                            </fo:table-row>
                                  
                            <fo:table-row>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt"/>
                                </fo:table-cell>
                                <fo:table-cell>
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">
          ==&gt;
        </fo:block>
                                </fo:table-cell>
                                <fo:table-cell>
