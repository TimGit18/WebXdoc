                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Komponenten der Plattform
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Komponenten der Plattform"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        JDK (Java Development Kit) 
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="JDK (Java Development Kit) "/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
