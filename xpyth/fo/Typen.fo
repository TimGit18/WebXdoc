                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Elementare Objekttypen
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Elementare Objekttypen"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Zahlen
                        <fo:leader leader-pattern="dots"/>
