    </fo:page-sequence>
    <fo:page-sequence master-reference="single-page" initial-page-number="3">
        <fo:static-content flow-name="xsl-region-after">
            <fo:block text-align="outside" font-family="Helvetica, Arial, sans-serif" font-size="10pt">
                          Seite
          
                <fo:page-number/>
            </fo:block>
        </fo:static-content>
        <fo:flow flow-name="xsl-region-body">
            <fo:block break-after="page" font-family="Helvetica, Arial, sans-serif">
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="20pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start">Objekttypen</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Der Objektbegriff ist universell im Sprachkonzept von Python. Objekte sind entweder Built-In-Konstrukte der Sprache oder 
      eigendefiniert. Zusammen mit dem Objektbegriff sind die dazugehörigen Operationen zu sehen. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Konzeptionelle Hierarchie">Konzeptionelle Hierarchie</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Python-Programme können gemäß folgender Reihenfolge in immer einfachere Bestandteile dekomponiert werden:
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">1.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Programme bestehen aus Modulen</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">2.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Module enthalten Statements oder Programm-Anweisungen</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">3.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Anweisungen enthalten Ausdrücke </fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">4.
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Ausdrücke erzeugen und verarbeiten Objekte</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Dabei sind Built-In-Konstrukte eine strukturelle Hilfe, da sie vielfach Routinearbeiten übernehmen wie die Auslagerung und 
      Allokation von Speichern, die Implementierung von Such- und Zugriffsalgorithmen usw. So haben sie weitere Vorteile wie 
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Einfachere Codierung für viele Problemdomänen wie Collections (Listen) oder Such-Tabellen (Dictionaries)</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Selbstentwickelte Erweiterungen basieren oft auf eingebauten Datentypen</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Effizientere Lösungen statt selbst programmierter Varianten</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Standardisierung</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Elementare Objekttypen">Elementare Objekttypen</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die folgende Tabelle umfasst die elementaren Objekttpyen in Python. Darunter versteht man nicht nur die elementaren Datentypen, 
      sondern auch komplexere, eingebaute Objekttpyen wie Listen oder Dictionaries sowie höhere Abstraktionsstufen.
    </fo:block>
                    
                <fo:block space-after="10pt" space-before="10pt">
                    <fo:table table-layout="fixed" width="100%">
                        <fo:table-header>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block background-color="#f0f0f0" font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">Objekttyp</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block background-color="#f0f0f0" font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">Beispiele für Repräsentanten</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                        </fo:table-header>
                        <fo:table-body>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Zahl</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">1234, 3,1415m 3+4j, 0b111, Decimal()</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">String</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">'Spam', "Bob's", b'a\x01c'</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Listen</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">[1,2,3,4,5], list(range(10))</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Dictionaries</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">{'#1' : 'spam', '#2' : 'yum'}, dict(hours=10)</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Dateien</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">open('file.txt'), open(r'C:\text.bin','wb')</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Mengen</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">set('abc'), {'a','b','c'}</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Sonstige</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Boolean, None</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                            <fo:table-row>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Programm-Units</fo:block>
                                </fo:table-cell>
                                <fo:table-cell border-color="black" border-style="solid">
                                    <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt">Funktionen, Module, Klassen</fo:block>
                                </fo:table-cell>
                            </fo:table-row>
                        </fo:table-body>
                    </fo:table>
                    <fo:block space-after="6pt" space-before="6pt" font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-style="italic">Tabelle 1: Elementare Objekttypen in Python</fo:block>
                </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Neben den einfachen Objekttypen sind auch Programm-Einheiten wie Funktionen, Module und Klassen verzeichnet. Diese Einheiten werden 
      mit Anweisungen und Ausdrücken wie def, class, import und lambda erzeugt. Außerdem bietet Python auch noch implementierte Objekte wie 
      compilierten Code an. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Objekte wie etwa Strings sind durch Anführungsstriche gekennzeichnet, Listen durch eckige und Dictionaries durch geschweifte Klammern. 
      An Objekte sind Operationen gebunden, wie String-Operationen an Strings und List-Operationen an Listen. Daher ist Python durch diese 
      automatische dynamisch typisiert, aber auch stark typisiert, denn eine Operation kann nur auf dem zugrundeliegenden Objekttyp operieren. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Zahlen">Zahlen</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Zahlen sind elementare Basistypen. Es gibt folgende numerische Ausprägungen:
    </fo:block>
                    
                <fo:list-block provisional-distance-between-starts="50mm" provisional-label-separation="10mm" space-after="4pt" space-before="4pt">
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Integers sind ganzahlige Datentypen</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Gleitkomma-Zahlen haben einen Bruchteil</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Komplexe Zahlen haben einen imaginären Anteil</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Dezimalzahlen haben einen festen Dezimalpunkt</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                    <fo:list-item>
                        <fo:list-item-label>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="normal">•
          </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body>
                            <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" start-indent="5mm">Rationale Zahlen bestehen aus Zählern und Nennern</fo:block>
                        </fo:list-item-body>
                    </fo:list-item>
                </fo:list-block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die folgenden Operationen sind elementare Operationen auf elementaren numerischen Datentypen.
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        #!usr/bin/python3
        # numbers.py
      
        # Ganzzahlige Addition
        summand1 = 123
        summand2 = 222
        summe = summand1 + summand2
        print(summe)
      
        # Gleitkomma-Multiplikation
        multiplikator = 1.5
        multiplikand = 4
        produkt = multiplikator * multiplikand
        print(produkt)
      
        # Exponentiation
        basis = 2
        exponent = 100
        potenz = basis ** exponent
        print(potenz)
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Die Länge einer Zahl wird über die Längenfunktion berechnet, dafür wird die Zahl über die Built-In-Funktion str auf einen String-Datentyp
      gecastet. 
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        # Laenge einer Zahl duch casting
        hochzahl = 2 ** 1000000
        laenge = len(str(hochzahl))
        print(laenge)
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Mathematische Module helfen bei der Berechnung komplexerer Ausdrücke und liefern nützliche Werkzeuge wie in den folgenden Beispielen, in 
      denen fortgeschrittene mathematische Funktionen und der Gebrauch der Zufallsfunktion behandelt werden:
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        #!usr/bin/python2
        # math.py
      
        import math
        import random
      
        # Berechnung der Kreisszahl Pi
        print(math.pi)
      
        # Berechnung der Wurzel aus 85
        print(math.sqrt(85))
      
        # Zufallszahl zwischen 0 und 1
        print(random.random())
      
        # Zufallszahl aus einer Menge vorgegebener Zahlen
        print (random.choice([1,2,3,4]))
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="14pt" font-weight="bold" space-after="10pt" space-before="10pt" text-align="start" id="Strings">Strings</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Strings sind Sequenzen von Zeichen (Characters). Man kann zahlreiche einfache Operationen auf Strings vornehmen. 
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">Einfache String-Operationen</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Das folgende Beispiel zeigt simple Operationen auf einem einfachen String. 
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        #!usr/bin/python3
        # strings.py
      
        # Deklaration
        string = 'Spam'
      
        # Länge, erstes und zweites Zeichen
        print(len(string))      # 4
        print(string[0])        # S
        print(string[1])        # p
      
        # Letzes und vorletzes Zeichen
        print(string[-1])       # m
        print(string[-2])       # a
      
        # Offsets
        print(string[1:3])      # pa
        print(string[1:])       # pam
        print(string[:3])       # Spa
        print(string[:])        # Spam
      
        # Konkatenation und Repitition
        print(string+'xyz')     # Spamxyz
        print(string*2)         # SpamSpam
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">String-Manipulationen</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Strings sind wie andere Basistypen unveränderbar. Aber sie können über andere Konstrukte (Listen, Byte-Arrays) manipuliert werden wie das 
      folgende Beispiel zeigt.
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        #!usr/bin/python3
        # stringsManipulation.py
      
        # String-Casting zu Liste
        string = 'shruberry'
        stringList = list(string)
        print(stringList)			# ['s', 'h', 'r', 'u', 'b', 'e', 'r', 'r', 'y']
      
        # Manipulation und 'recasting'
        stringList[1] =  'c'
        stringList = ''.join(stringList)
        print(stringList)			# scruberry
      
        # Manipulaiton über Bytelisten
        byteList = bytearray(b'spam')   	# Hybrid
        byteList.extend(b'eggs')
        print(byteList)			# bytearray(b'spameggs')
        print(byteList.decode())		# spameggs
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">Suchen und Ersetzen</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      String-spezifische Methoden sind ebenfalls leicht anwendbar. Die Methode find ist eine Suchoperation auf eine Substring und die Methode 
      replace ersetzt Strings auf Basis einer globalen Suche. 
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        #!usr/bin/python3
        # stringsMethods.py
      
        # Methode find sucht auf einen Substring
        string = 'Spam'
        print(string.find('pa'))        	# 1
      
        # Die Methode replace ersetzt einen Suchstring durch einen Ersatz
        print(string.replace('pa','XYZ'))     # SXYZm
      
        # Uppercase und Alphanumeric-Test
        print(string.upper())                   # SPAM
        print(string.isalpha())                 # True
    </fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" font-weight="bold">Formatierungen</fo:block>
                    
                <fo:block font-family="Helvetica, Arial, sans-serif" font-size="10pt" text-align="justify" space-before="10pt" space-after="10pt">
      Weitere Methoden, die von den String- und Number-Objekttypen unterstützt werden, sind Formatierungsmethoden
    </fo:block>
                    
                <fo:block font-family="Courier" font-size="6pt" linefeed-treatment="preserve" white-space-treatment="preserve" space-before="0pt" space-after="4pt" text-align="start" white-space-collapse="false">
        #!usr/bin/python3
        # stringsNumbsFormat.py
      
        # Formatierung von Strings
        string = '%s, eggs, and %s'                             # Generische Formatierung mit %
        stringFormat = string % ('spam','SPAM!')                # Ersetze die Platzhalter
        print(stringFormat)                                     # spam, eggs, and SPAM!
      
        # Formatierung von Zahlen (in 1000er Schritten)
        floatingNumber = 296999.2567
        floatingNumberFormat = '{:,.2f}'.format(floatingNumber) # Tausender Kennzeichen und
                                                                # Abrunden zweite Stelle hinter Punkt
        print(floatingNumberFormat)                             # 296,999.26
      
        # Abrunden
        piNumber = 3.14159
        roundPiNumber = '%.2f' % piNumber                       # Abrunden zweite Stelle hinter Punkt
        print(roundPiNumber)                                    # 3.14
      
        # Auffüllen
        negativeNumber = -42
        paddingNegativeNumber = '%+05d' % negativeNumber        # Auffüllen mit Nullen bis zur 5.Stelle
        print(paddingNegativeNumber)                            # -0042
    </fo:block>
                  
            </fo:block>
        </fo:flow>
    </fo:page-sequence>
</fo:root>
