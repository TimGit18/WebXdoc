                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Übersetzungsprozess
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Übersetzungsprozess"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Interaktion
                        <fo:leader leader-pattern="dots"/>
                        <fo:page-number-citation ref-id="Interaktion"/>
                    </fo:inline>
                </fo:block>
                <fo:block text-align-last="justify">
                    <fo:inline>
                        Modularisierung
                        <fo:leader leader-pattern="dots"/>
